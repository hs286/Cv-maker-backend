<html lang='en-US'>

<head>
  <meta content='text/html; charset=utf-8' http-equiv='Content-Type' />
  <title>{{fullName}} - Email Verification OTP Code</title>
  <meta name='description' content='Email Verification With OTP Code Template.' />
  <style type='text/css'>
    body {
      font-family: 'Arial', sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -webkit-text-size-adjust: none;
      height: 100%;
      width: 100%;
      line-height: 1.6em;
      color: #555555;
    }

    table {
      border-collapse: collapse !important;
      width: 100% !important;
    }

    a {
      color: #3498db;
    }

    a:hover {
      text-decoration: underline !important;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      color: #333333;
      font-weight: 700;
      margin: 0;
      line-height: 1.3;
    }

    p {
      font-size: 16px;
      color: #777777;
      margin: 8px 0 0;
      line-height: 24px;
    }

    strong {
      color: #333333;
      font-weight: 700;
    }

    .container {
      display: block !important;
      max-width: 600px !important;
      margin: 0 auto !important;
      clear: both !important;
    }

    .header {
      background-color: #3498db;
      padding: 20px;
      text-align: center;
      border-top-left-radius: 8px;
      border-top-right-radius: 8px;
    }

    .header h1 {
      color: #ffffff;
      font-size: 32px;
      margin: 0;
    }

    .content {
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      padding: 30px;
      margin-top: 20px;
    }

    .footer {
      padding: 20px;
      background-color: #f4f4f4;
      color: #777777;
      font-size: 14px;
      line-height: 20px;
      border-bottom-left-radius: 8px;
      border-bottom-right-radius: 8px;
    }

    .button {
      background: #3498db;
      text-decoration: none !important;
      display: inline-block;
      font-weight: 700;
      margin-top: 24px;
      color: #ffffff;
      text-transform: uppercase;
      font-size: 16px;
      padding: 12px 24px;
      display: inline-block;
      border-radius: 4px;
    }
  </style>
</head>

<body>
<table cellspacing='0' border='0' cellpadding='0' width='100%' bgcolor='#f4f4f4'>
  <tr>
    <td>
      <table class="container header">
        <tr>
          <td>
            <h1>Email Verification OTP Code</h1>
          </td>
        </tr>
      </table>
      <table class="container content">
        <tr>
          <td>
            <p>Hi {{fullName}},</p>
            <p>Please use the OTP code: {{otpCode}} to verify your email address. Don't share your OTP code with
              others.</p>
          </td>
        </tr>
      </table>
      <table class="container footer">
        <tr>
          <td>
            <!-- Footer Section -->
            <p>Thank you,<br>The Spyre Team.</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
<!--/100% body table-->
</body>

</html>
