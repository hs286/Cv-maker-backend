<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
  <title>{{ clientName }} - Service Notification</title>
  <meta name="description" content="Service Notification Email Template." />
  <style type="text/css">
    body {
      font-family: 'Arial', sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -webkit-text-size-adjust: none;
      height: 100%;
      width: 100%;
      line-height: 1.6em;
      color: #000000;
    }
    table {
      border-collapse: collapse !important;
      width: 100% !important;
    }
    a {
      color: #000000;
    }
    a:hover {
      text-decoration: underline !important;
    }
    h1, h2, h3, h4, h5, h6 {
      color: #000000;
      font-weight: 700;
      margin: 0;
      line-height: 1.3;
      text-align: left;
    }
    p {
      font-size: 14px;
      color: #000000;
      margin: 8px 0 0;
      line-height: 22px;
      text-align: left;
    }
    strong {
      color: #000000;
      font-weight: 700;
      text-align: left;
    }
    .container {
      display: block !important;
      max-width: 600px !important;
      margin: 0 auto !important;
      clear: both !important;
    }
    .header {
      background-color: #3498db;
      padding: 20px;
      text-align: center;
      border-top-left-radius: 8px;
      border-top-right-radius: 8px;
    }
    .header h1 {
      color: #ffffff;
      font-size: 32px;
      margin: 0;
    }
    .content {
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      padding: 30px;
      margin-top: 20px;
      text-align: left;
    }
    .footer {
      padding: 20px;
      background-color: #f4f4f4;
      color: #000000;
      font-size: 12px;
      line-height: 20px;
      border-bottom-left-radius: 8px;
      border-bottom-right-radius: 8px;
      text-align: left;
    }
    .button {
      background: #3498db;
      text-decoration: none !important;
      display: inline-block;
      font-weight: 700;
      margin-top: 24px;
      color: #ffffff;
      text-transform: uppercase;
      font-size: 16px;
      padding: 12px 24px;
      display: inline-block;
      border-radius: 4px;
      text-align: left;
    }
  </style>
</head>
<body>
  <!-- 100% body table -->
  <table cellspacing="0" border="0" cellpadding="0" width="100%" bgcolor="#f4f4f4">
    <tr>
      <td>
        <table class="container header">
          <tr>
            <td>
              <!-- Header Section -->
              <h1>Service Notification</h1>
            </td>
          </tr>
        </table>
        <table class="container content">
          <tr>
            <td>
              <!-- Content Section -->
              <p>Hello {{ clientName }},</p>
              <p>I hope this email finds you well.</p>
              <p>{{{ bodyContent }}}</p>
              <p>Regards,<br>{{ specialistName }}<br>CV Specialist and Career Coaching Expert</p>
            </td>
          </tr>
        </table>
        <table class="container footer">
          <tr>
            <td>
              <!-- Footer Section -->
              <p>The Spyre Team.<br />
                020 8050 0018<br />
                Spyre Ltd, Finchley Road, London, NW117ES.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  <!--/100% body table-->
</body>
</html>
